# 백엔드 연동 시 사용할 환경 변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 커밋되지 않습니다)

# 백엔드 API 주소
VITE_API_BASE_URL=http://localhost:8080

# 카카오 JavaScript 키 (지도 SDK)
# 브라우저에 노출되는 값이므로 카카오 개발자 콘솔에서 반드시 도메인 제한을 걸어주세요.
VITE_KAKAO_JS_KEY=

# 카카오 REST API 키 (로그인 인가코드 발급용)
# 미설정이면 MY 탭의 카카오 로그인 버튼이 "준비 중"으로 표시되고 게스트 로그인만 동작합니다.
# 리다이렉트 URI: {서비스 도메인}/auth/kakao — 카카오 콘솔과 백엔드 .env(KAKAO_REDIRECT_URI)에 동일하게 등록
VITE_KAKAO_REST_KEY=

# 주의: 한국관광공사 OpenAPI 서비스키는 프론트엔드에 두지 마세요.
# VITE_ 접두사가 붙은 값은 빌드 결과물에 그대로 포함되어 누구나 볼 수 있습니다.
# 관광공사 API는 반드시 백엔드에서 호출하세요.
